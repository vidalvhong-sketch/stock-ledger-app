# Copy this to .env for local dev. On Railway, set these as Variables instead.

# Secret used to sign login sessions — set a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on (Railway sets this automatically, override for local dev)
PORT=3000

# Where the SQLite database file is stored. On Railway, point this at a mounted volume
# (e.g. /app/data) so the database survives redeploys. Defaults to ./data locally.
DATA_DIR=./data

# Alternative to DATA_DIR — a full path to the database FILE itself, e.g. /app/data/inventory.db
# If set, this takes priority over DATA_DIR. Matches the convention used by stockline.
# DATABASE_PATH=/app/data/inventory.db

# PIN for the auto-seeded first admin account (only used the very first time the app runs
# with an empty database). Defaults to 1234 if not set — change it after first login regardless.
DEFAULT_ADMIN_PIN=1234
